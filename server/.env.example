# Copy this file to .env and set your own values.

# Port the API (and the built admin dashboard) listens on.
PORT=4000

# Required: password for logging in to the admin dashboard.
ADMIN_PASSWORD=change-me

# Optional: secret used to sign login tokens. If empty, a random one is generated
# on every start (you'll just need to log in again after a restart).
TOKEN_SECRET=

# How long a login lasts, in hours.
TOKEN_TTL_HOURS=12

# Where content is stored. By default the server edits the front-end's bundled
# content file directly, so saved changes go live on the next build / git push.
CONTENT_FILE=../front/src/data/content.json

# The front-end's public folder. Uploaded images are saved to <PUBLIC_DIR>/uploads.
PUBLIC_DIR=../front/public

# Built admin dashboard, served at /admin (run `npm run build` in ../admin first).
ADMIN_DIST=../admin/dist

# Built portfolio site, served at / (run `npm run build` in ../front first).
FRONT_DIST=../front/dist

# Comma-separated origins allowed to call the API from a browser (e.g. your live site
# when using VITE_CONTENT_URL). Use * to allow any origin.
CORS_ORIGIN=*
